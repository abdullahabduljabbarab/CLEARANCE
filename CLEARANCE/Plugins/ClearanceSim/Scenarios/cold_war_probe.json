{
  "metadata": {
    "id": "cold_war_probe",
    "name": "Cold War Probe",
    "brief": "Three unknown contacts inbound from three different bearings, all IFF off, all at low altitude. One civilian transit in the middle. Player has to identify which contacts are real threats and which are recon turning away at the line - scrambling on a recon penetration is a wasted asset, missing the real attacker is catastrophic. Multi-bandit GCI doctrine.",
    "location": "Northern ADIZ",
    "roe": "Standing GCI doctrine. Interrogate each contact. Real threats press through and target protected airspace; probes turn outbound at the ADIZ line. Each contact must be classified individually before scrambling - mis-ID a recon as hostile and you eat a thousand point penalty. Multiple correct intercepts win.",
    "difficulty": "Hard",
    "keepLevelZones": false
  },

  "environment": {
    "windDirectionDeg": 10,
    "windSpeedKts": 15,
    "activeRunwayHeadingDeg": 360
  },

  "initialSpawns": [
    {
      "callsign": "BAW501",
      "type": "MEDIUM",
      "positionNm": { "x": 0, "y": 50 },
      "headingDeg": 180,
      "speedKts": 290,
      "altitudeFt": 35000,
      "squawk": 1501,
      "threat": "Neutral",
      "iff": true
    }
  ],

  "timedEvents": [
    {
      "atSec": 20,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "AWACS",
          "voice": "en-US-EricNeural",
          "text": "Magic, multiple unknown contacts north of the ADIZ line, low altitude, all squawking dark. Stand by for vectors."
        }
      }
    },
    {
      "atSec": 30,
      "action": {
        "type": "spawn",
        "params": {
          "callsign": "UNKNOWN01",
          "type": "FIGHTER",
          "x": -85,
          "y": 90,
          "headingDeg": 135,
          "speedKts": 320,
          "altitudeFt": 9000,
          "squawk": 0,
          "threat": "Unknown",
          "trueAffiliation": "Hostile",
          "iff": false
        }
      }
    },
    {
      "atSec": 45,
      "action": {
        "type": "spawn",
        "params": {
          "callsign": "UNKNOWN02",
          "type": "FIGHTER",
          "x": 15,
          "y": 100,
          "headingDeg": 180,
          "speedKts": 320,
          "altitudeFt": 11000,
          "squawk": 0,
          "threat": "Unknown",
          "trueAffiliation": "Hostile",
          "iff": false
        }
      }
    },
    {
      "atSec": 60,
      "action": {
        "type": "spawn",
        "params": {
          "callsign": "UNKNOWN03",
          "type": "FIGHTER",
          "x": 90,
          "y": 80,
          "headingDeg": 225,
          "speedKts": 320,
          "altitudeFt": 8000,
          "squawk": 0,
          "threat": "Unknown",
          "trueAffiliation": "Hostile",
          "iff": false
        }
      }
    },
    {
      "atSec": 65,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "AWACS",
          "voice": "en-US-EricNeural",
          "text": "Magic, three unknowns established. Two believed probes - typical pattern is to turn back at the line. One is pressing south on a steady course. Identify and prioritize."
        }
      }
    },
    {
      "atSec": 120,
      "action": {
        "type": "pursue",
        "params": { "hunter": "UNKNOWN02", "target": "BAW501" }
      }
    },
    {
      "atSec": 130,
      "action": {
        "type": "breakOff",
        "params": { "callsign": "UNKNOWN01" }
      }
    },
    {
      "atSec": 150,
      "action": {
        "type": "breakOff",
        "params": { "callsign": "UNKNOWN03" }
      }
    }
  ],

  "triggers": [
    {
      "id": "real_threat_close_to_civilian",
      "once": true,
      "when": {
        "type": "distanceBetween",
        "params": { "a": "BAW501", "b": "UNKNOWN02", "lessThanNm": 15 }
      },
      "then": {
        "type": "injectMessage",
        "params": {
          "callsign": "AWACS",
          "voice": "en-US-EricNeural",
          "text": "Magic, unknown zero two pressing on civilian Speedbird five zero one. Recommend immediate intercept."
        }
      }
    },
    {
      "id": "scenario_complete_on_exit",
      "once": true,
      "when": {
        "type": "aircraftCount",
        "params": { "op": "eq", "count": 0 }
      },
      "then": {
        "type": "finishScenario",
        "params": {}
      }
    }
  ]
}
