  "metadata": {
    "id": "mixed_ops",
    "name": "Mixed Ops",
    "brief": "Heavy civilian transit, multiple placed restricted areas active for the duration (military training zones, P-areas, nuclear sites). Player has to keep eight civilians moving through the sector without anyone busting a restricted area boundary. No emergencies, no GCI - pure controller spatial awareness under load.",
    "location": "Continental Sector with restricted zones",
    "roe": "Civilians have active IFF. Any civilian Friendly entering a restricted area = airspace bust (-150). Player has to plan vectors that route around the placed zones. Vector verb is `vector <callsign> <heading>` - spoken or typed.",
    "difficulty": "Medium",
    "keepLevelZones": true
  },

