{
  "metadata": {
    "id": "nordo_inbound",
    "name": "NORDO Inbound",
    "brief": "Two aircraft go comms-failure simultaneously - radios dead, transponders set to seven six zero zero. Both fly the published lost-comms procedure on autopilot: turn for the active runway, descend to three thousand, fly the ILS as if cleared. Player can't talk to them. The job is to vector every OTHER aircraft in the sector clear of their predicted tracks before any separation breaks.",
    "location": "Main Sector",
    "roe": "ICAO 7600 doctrine. NORDO traffic has right of way during lost-comms recovery. Use spoken commands on the four non-NORDO aircraft only - the two NORDOs will ignore everything and fly themselves to the runway. Three separation events ends the scenario as a controller failure.",
    "difficulty": "Hard",
    "keepLevelZones": false
  },

  "environment": {
    "windDirectionDeg": 270,
    "windSpeedKts": 10,
    "activeRunwayHeadingDeg": 270
  },

  "initialSpawns": [
    {
      "callsign": "BAW118",
      "type": "MEDIUM",
      "positionNm": { "x": 45, "y": 12 },
      "headingDeg": 270,
      "speedKts": 260,
      "altitudeFt": 13000,
      "squawk": 1118,
      "threat": "Neutral",
      "iff": true
    },
    {
      "callsign": "DLH445",
      "type": "MEDIUM",
      "positionNm": { "x": 50, "y": -15 },
      "headingDeg": 270,
      "speedKts": 250,
      "altitudeFt": 16000,
      "squawk": 1445,
      "threat": "Neutral",
      "iff": true
    },
    {
      "callsign": "AFR776",
      "type": "MEDIUM",
      "positionNm": { "x": -35, "y": 5 },
      "headingDeg": 90,
      "speedKts": 285,
      "altitudeFt": 22000,
      "squawk": 1776,
      "threat": "Neutral",
      "iff": true
    },
    {
      "callsign": "RYR320",
      "type": "MEDIUM",
      "positionNm": { "x": 10, "y": -45 },
      "headingDeg": 360,
      "speedKts": 270,
      "altitudeFt": 17000,
      "squawk": 1320,
      "threat": "Neutral",
      "iff": true
    },
    {
      "callsign": "KLM509",
      "type": "MEDIUM",
      "positionNm": { "x": -20, "y": 35 },
      "headingDeg": 135,
      "speedKts": 290,
      "altitudeFt": 28000,
      "squawk": 1509,
      "threat": "Neutral",
      "iff": true
    },
    {
      "callsign": "EZY882",
      "type": "MEDIUM",
      "positionNm": { "x": 30, "y": 30 },
      "headingDeg": 225,
      "speedKts": 265,
      "altitudeFt": 19000,
      "squawk": 1882,
      "threat": "Neutral",
      "iff": true
    }
  ],

  "timedEvents": [
    {
      "atSec": 30,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "BAW118", "kind": "CommsFailure" }
      }
    },
    {
      "atSec": 33,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "ACC",
          "voice": "en-GB-RyanNeural",
          "text": "Speedbird one one eight squawking seven six zero zero. Comms failure. He will fly the published lost comms procedure to the active runway."
        }
      }
    },
    {
      "atSec": 60,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "DLH445", "kind": "CommsFailure" }
      }
    },
    {
      "atSec": 64,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "ACC",
          "voice": "en-GB-RyanNeural",
          "text": "Lufthansa four four five also squawking seven six zero zero. Second NORDO inbound. Keep the other traffic clear of both tracks."
        }
      }
    }
  ],

  "triggers": [
    {
      "id": "nordo_pair_breakdown",
      "once": true,
      "when": {
        "type": "distanceBetween",
        "params": { "a": "BAW118", "b": "DLH445", "lessThanNm": 5 }
      },
      "then": {
        "type": "logIncident",
        "params": {
          "note": "Two NORDO aircraft inside 5nm of each other. Controller could not direct either - traffic management failed."
        }
      }
    },
    {
      "id": "civilian_into_nordo_corridor",
      "once": true,
      "when": {
        "type": "distanceBetween",
        "params": { "a": "BAW118", "b": "AFR776", "lessThanNm": 5 }
      },
      "then": {
        "type": "logIncident",
        "params": {
          "note": "AFR776 too close to NORDO BAW118 - the operator must vector the talker out of the NORDO's path."
        }
      }
    },
    {
      "id": "scenario_complete_on_exit",
      "once": true,
      "when": {
        "type": "aircraftCount",
        "params": { "op": "eq", "count": 0 }
      },
      "then": {
        "type": "finishScenario",
        "params": {}
      }
    }
  ]
}
