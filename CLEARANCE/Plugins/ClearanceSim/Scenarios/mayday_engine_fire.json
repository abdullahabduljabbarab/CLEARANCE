  "timedEvents": [
    {
      "atSec": 25,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "BAW394", "kind": "Mayday" }
      }
    },
    {
      "atSec": 28,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "ACC",
          "voice": "en-GB-RyanNeural",
          "text": "Speedbird three nine four declaring Mayday, engine fire, smoke in cockpit, requesting immediate landing. Clear all traffic from his approach corridor."
        }
      }
    },
    {
      "atSec": 240,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "ACC",
          "voice": "en-GB-RyanNeural",
          "text": "Speedbird three nine four reports the fire is spreading. Four minutes elapsed since declaration. Expedite the approach."
        }
      }
    }
  ],

  "triggers": [
    {
      "id": "mayday_traffic_breakdown",
      "once": true,
      "when": {
        "type": "distanceBetween",
        "params": { "a": "BAW394", "b": "DLH812", "lessThanNm": 6 }
      },
      "then": {
        "type": "logIncident",
        "params": {
          "note": "DLH812 within 6nm of Mayday aircraft BAW394 - separation breakdown during emergency. Vector traffic clear of the emergency corridor."
        }
      }
    },
    {
      "id": "scenario_complete_on_exit",
      "once": true,
      "when": {
        "type": "aircraftCount",
        "params": { "op": "eq", "count": 0 }
      },
      "then": {
        "type": "finishScenario",
        "params": {}
      }
    }
  ]
