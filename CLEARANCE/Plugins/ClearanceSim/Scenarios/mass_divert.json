{
  "metadata": {
    "id": "mass_divert",
    "name": "Mass Divert",
    "brief": "Six aircraft inbound to the airport at staggered stages of approach when severe weather rolls in and closes the active runway. The runway is unusable for the rest of the scenario. Player has five minutes to divert every aircraft out of the sector to the alternate field before fuel reserves cascade into emergencies. Pure ATC tempo test.",
    "location": "Main Sector",
    "roe": "Civil ATC. No GCI involvement. Use `clearance.exit <callsign>` to clear an aircraft out of the sector. Aircraft still in sector at T+5 minutes start declaring fuel emergencies. Three or more fuel emergencies = sector failure.",
    "difficulty": "Hard",
    "keepLevelZones": false
  },

  "environment": {
    "windDirectionDeg": 250,
    "windSpeedKts": 14,
    "activeRunwayHeadingDeg": 270
  },

  "initialSpawns": [
    {
      "callsign": "BAW123",
      "type": "MEDIUM",
      "positionNm": { "x": 30, "y": 6 },
      "headingDeg": 270,
      "speedKts": 220,
      "altitudeFt": 7000,
      "squawk": 1232,
      "threat": "Friendly",
      "iff": true
    },
    {
      "callsign": "DLH456",
      "type": "MEDIUM",
      "positionNm": { "x": 38, "y": -4 },
      "headingDeg": 270,
      "speedKts": 240,
      "altitudeFt": 9000,
      "squawk": 1456,
      "threat": "Friendly",
      "iff": true
    },
    {
      "callsign": "AFR789",
      "type": "MEDIUM",
      "positionNm": { "x": 50, "y": 2 },
      "headingDeg": 270,
      "speedKts": 260,
      "altitudeFt": 12000,
      "squawk": 1789,
      "threat": "Friendly",
      "iff": true
    },
    {
      "callsign": "KLM234",
      "type": "MEDIUM",
      "positionNm": { "x": -40, "y": 25 },
      "headingDeg": 110,
      "speedKts": 270,
      "altitudeFt": 16000,
      "squawk": 1234,
      "threat": "Friendly",
      "iff": true
    },
    {
      "callsign": "RYR567",
      "type": "MEDIUM",
      "positionNm": { "x": -45, "y": -15 },
      "headingDeg": 70,
      "speedKts": 270,
      "altitudeFt": 19000,
      "squawk": 1567,
      "threat": "Friendly",
      "iff": true
    },
    {
      "callsign": "EZY890",
      "type": "MEDIUM",
      "positionNm": { "x": 5, "y": 55 },
      "headingDeg": 200,
      "speedKts": 280,
      "altitudeFt": 22000,
      "squawk": 1890,
      "threat": "Friendly",
      "iff": true
    }
  ],

  "timedEvents": [
    {
      "atSec": 15,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "MET",
          "voice": "en-GB-LibbyNeural",
          "text": "Weather advisory. Severe storm cell tracking toward the field. Wind shear and crosswind expected to exceed runway limits within ninety seconds."
        }
      }
    },
    {
      "atSec": 30,
      "action": {
        "type": "setWind",
        "params": { "directionDeg": 90, "speedKts": 38 }
      }
    },
    {
      "atSec": 35,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "TOWER",
          "voice": "en-GB-RyanNeural",
          "text": "All traffic, the runway is closed due to severe crosswind. Divert all inbound aircraft to alternate. Repeat, runway closed, divert to alternate."
        }
      }
    },
    {
      "atSec": 240,
      "action": {
        "type": "injectMessage",
        "params": {
          "callsign": "TOWER",
          "voice": "en-GB-RyanNeural",
          "text": "Four minutes elapsed. Any aircraft still in the sector is approaching fuel reserve minimums. Expedite divert."
        }
      }
    },
    {
      "atSec": 300,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "BAW123", "kind": "FuelLow" }
      }
    },
    {
      "atSec": 310,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "DLH456", "kind": "FuelLow" }
      }
    },
    {
      "atSec": 320,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "AFR789", "kind": "FuelLow" }
      }
    },
    {
      "atSec": 335,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "KLM234", "kind": "FuelLow" }
      }
    },
    {
      "atSec": 350,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "RYR567", "kind": "FuelLow" }
      }
    },
    {
      "atSec": 365,
      "action": {
        "type": "declareEmergency",
        "params": { "callsign": "EZY890", "kind": "FuelLow" }
      }
    }
  ],

  "triggers": [
    {
      "id": "scenario_complete_on_exit",
      "once": true,
      "when": {
        "type": "aircraftCount",
        "params": { "op": "eq", "count": 0 }
      },
      "then": {
        "type": "finishScenario",
        "params": {}
      }
    }
  ]
}
